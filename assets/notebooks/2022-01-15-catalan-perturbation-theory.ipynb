    "NTerm[x_Term, nn_, h0_, vv_] := \n",
    "  EvaluateTerm[x, nn, Length[h0]] /. {e[i_] :> h0[[i, i]], \n",
    "    v[i_, j_] :> vv[[i, j]]};\n",
    "NTerm[expr_, nn_, h0_, vv_] := expr /. x_Term :> NTerm[x, nn, h0, vv];"
   ]

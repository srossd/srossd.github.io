    "op[n_] := \n",
    "  NonCommutativeMultiply @@ Table[Operator[ad] + Operator[a], n];\n",
    "states = Table[1/Sqrt[n!] State @@ Table[ad, n], {n, 0, 5}];\n",
    "\n",
    "MatrixElements[op[2], states] // MatrixForm"
   ]

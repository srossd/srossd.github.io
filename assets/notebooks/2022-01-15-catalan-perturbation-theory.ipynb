    "CanonicalTerm[x_Term] := \n",
    "  First@Sort@NestList[RotateLeft, x, Length[x] - 1];\n",
    "AllTerms[order_] := \n",
    "  DeleteDuplicates[\n",
    "   CanonicalTerm /@ \n",
    "    Flatten[Term @@@ (Permutations@PadLeft[#, order]) & /@ \n",
    "      IntegerPartitions[order - 1], 1]];\n",
    "\n",
    "AllTerms[4]"
   ]
  },

   "source": [
    "DistinctPartitions[n_] := \n",
    "  Select[IntegerPartitions[n], Length[#] == Length[Union[#]] &];\n",
    "\n",
    "EvenOdd[n_] := \n",
    " With[{dp = DistinctPartitions[n]}, \n",
    "  Grid[{Column[Select[dp, #]] & /@ {EvenQ@*Length, OddQ@*Length}}, \n",
    "   Alignment -> Top]]; \n",
    "\n",
    "EvenOdd[14]"
   ]
  },
